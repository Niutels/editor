# Optional environment variables

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# Public editor origin used by Mint OAuth and same-origin checks.
# Set this when Pascal is hosted outside editor.pascal.app.
# MINT_PASCAL_HOST_ORIGIN=https://pascal.example.com

# Canonical Landrush multiplayer servers must keep this outside the deployed release.
# LANDRUSH_WORLD_MULTIPLAYER_DATA_DIR=/var/lib/landrush
# Only set this to 1 for the first boot of an intentionally empty production world.
# LANDRUSH_WORLD_MULTIPLAYER_ALLOW_EMPTY_STATE=1
