{
  "name": "landrush",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "sync:pascal-assets": "node scripts/sync-pascal-assets.mjs",
    "build:runtime-workers": "bun scripts/build-landrush-runtime-workers.mjs --minify",
    "generate:island-ambient-assets": "node scripts/generate-island-ambient-assets.mjs",
    "optimize:island-ambient-assets": "node scripts/optimize-island-ambient-assets.mjs",
    "audit:island-ambient-assets": "node scripts/audit-island-ambient-assets.mjs",
    "generate:zombie-escape-assets": "node scripts/generate-zombie-escape-assets.mjs",
    "generate:zombie-escape-authored-vat": "bun scripts/generate-zombie-escape-authored-vat.mjs",
    "audit:zombie-escape-authored-vat": "bun scripts/generate-zombie-escape-authored-vat.mjs --check",
    "generate:zombie-night-lightpost": "node scripts/generate-zombie-night-street-lightpost.mjs",
    "optimize:zombie-night-lightpost": "node scripts/optimize-zombie-night-street-lightpost.mjs",
    "test:zombie-night-lightpost": "node --test scripts/zombie-night-street-lightpost-asset.test.mjs",
    "optimize:zombie-escape-weapon-assets": "node scripts/zombie-escape-weapon-glb-optimizer.mjs",
    "audit:zombie-escape-assets": "node scripts/audit-zombie-escape-assets.mjs",
    "audit:zombie-escape-assets:shipping": "node scripts/audit-zombie-escape-assets.mjs --no-write --quiet",
    "test:zombie-escape-weapon-assets": "node --test scripts/zombie-escape-weapon-glb-optimizer.test.mjs scripts/audit-zombie-escape-assets.test.mjs",
    "generate:zombie-escape-audio": "node scripts/generate-zombie-escape-audio.mjs",
    "record:zombie-escape-audio-web": "node scripts/generate-zombie-escape-audio.mjs --record-web --prompt-improvement=off --explore-sharing=off",
    "audit:zombie-escape-audio": "node scripts/audit-zombie-escape-audio.mjs --require-ready",
    "audit:zombie-escape-audio:shipping": "node scripts/audit-zombie-escape-audio.mjs --require-ready --skip-media-probe",
    "test:zombie-escape-audio-pipeline": "node --test scripts/audit-zombie-escape-audio.test.mjs",
    "dev": "bun run sync:pascal-assets && dotenv -e ../../.env.local -- bun scripts/dev-with-landrush-ws.mjs",
    "dev:next": "bun run sync:pascal-assets && dotenv -e ../../.env.local -- bun scripts/dev-with-landrush-ws.mjs --next-only",
    "dev:world-multiplayer-ws": "bun scripts/landrush-world-multiplayer-ws.mjs",
    "build": "bun run sync:pascal-assets && bun run build:runtime-workers && bun run audit:zombie-escape-assets:shipping && bun run audit:zombie-escape-authored-vat && bun run audit:zombie-escape-audio:shipping && dotenv -e ../../.env.local -- next build",
    "start": "bun run sync:pascal-assets && bun run build:runtime-workers && next start",
    "lint": "biome lint",
    "check-types": "next typegen && tsc --noEmit",
    "test": "bun test components/landrush-lab lib && bun run test:zombie-escape-weapon-assets && bun run test:zombie-night-lightpost"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@number-flow/react": "^0.6.0",
    "@landrush/pascal-host": "*",
    "@landrush/pascal-plugin": "*",
    "@landrush/protocol": "*",
    "@landrush/runtime": "*",
    "@landrush/zombie-gameplay": "*",
    "@pascal-app/core": "*",
    "@pascal-app/editor": "*",
    "@pascal-app/mcp": "*",
    "@pascal-app/nodes": "*",
    "@pascal-app/plugin-trees": "github:pascalorg/plugin-trees#56d978cd9b409b716207b3f3d269455d3cd6f067",
    "@pascal-app/viewer": "*",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.2.1",
    "clsx": "^2.1.1",
    "earcut": "3.0.2",
    "geist": "^1.7.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.7.0",
    "next": "16.3.0",
    "polygon-clipping": "0.15.7",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.185.0",
    "three-mesh-bvh": "~0.9.8",
    "ws": "^8.21.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@pascal/typescript-config": "*",
    "@types/earcut": "3.0.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.19.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "agentation": "^3.0.2",
    "react-grab": "^0.1.50",
    "react-scan": "^0.5.7",
    "sharp": "0.34.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
