{
  "extends": "@pascal/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/landrush-lab/natural-road-plan.worker.ts",
    "components/landrush-lab/procedural-rock-cliff.worker.ts",
    "components/landrush-lab/landrush-zombie-escape-collision-world.worker.ts",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/viewer" }
  ]
}
