  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsgo --noEmit"
  },
  "peerDependencies": {
    "@landrush/runtime": "*",
    "@pascal-app/core": "*",
    "@pascal-app/editor": "*",
    "@pascal-app/viewer": "*",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@landrush/runtime": "*",
    "@pascal-app/core": "*",
    "@pascal-app/editor": "*",
    "@pascal-app/viewer": "*",
    "@pascal/typescript-config": "*",
    "@types/react": "^19.2.2",
    "react": "^19.2.4",
    "typescript": "7.0.2"
  },
  "private": true
}
