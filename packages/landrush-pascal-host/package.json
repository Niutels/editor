{
  "name": "@landrush/pascal-host",
  "version": "0.1.0",
  "description": "Landrush composition boundary for the public Pascal editor and viewer APIs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./landrush-build-footprints": {
      "types": "./src/landrush-build-footprints.ts",
      "default": "./src/landrush-build-footprints.ts"
    },
    "./landrush-island-ambient-navigation-semantics": {
      "types": "./src/landrush-island-ambient-navigation-semantics.ts",
      "default": "./src/landrush-island-ambient-navigation-semantics.ts"
    },
    "./landrush-build-sync": {
      "types": "./src/landrush-build-sync.ts",
      "default": "./src/landrush-build-sync.ts"
    },
    "./landrush-parcel-build-graph": {
      "types": "./src/landrush-parcel-build-graph.ts",
      "default": "./src/landrush-parcel-build-graph.ts"
    },
    "./landrush-building-floor-visibility": {
      "types": "./src/landrush-building-floor-visibility.ts",
      "default": "./src/landrush-building-floor-visibility.ts"
    },
    "./landrush-zombie-escape-first-house": {
      "types": "./src/landrush-zombie-escape-first-house.ts",
      "default": "./src/landrush-zombie-escape-first-house.ts"
    },
    "./zombie-escape-weapon-placement": {
      "types": "./src/zombie-escape-weapon-placement.ts",
      "default": "./src/zombie-escape-weapon-placement.ts"
    },
    "./zombie-game-navigation": {
      "types": "./src/zombie-game-navigation.ts",
      "default": "./src/zombie-game-navigation.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsgo --noEmit",
    "test": "bun test src"
  },
  "peerDependencies": {
    "@landrush/zombie-gameplay": "*",
    "@landrush/runtime": "*",
    "@pascal-app/core": "*",
    "@pascal-app/editor": "*",
    "@pascal-app/viewer": "*",
    "@react-three/fiber": "^9",
    "react": "^18 || ^19",
    "three": "^0.185"
  },
  "devDependencies": {
    "@landrush/zombie-gameplay": "*",
    "@landrush/runtime": "*",
    "@pascal-app/core": "*",
    "@pascal-app/editor": "*",
    "@pascal-app/viewer": "*",
    "@react-three/fiber": "^9.5.0",
    "@pascal/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.19.12",
    "@types/react": "^19.2.2",
    "@types/three": "^0.184.1",
    "react": "^19.2.4",
    "three": "^0.185.0",
    "typescript": "7.0.2"
  },
  "private": true
}
