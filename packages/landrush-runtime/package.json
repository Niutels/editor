{
  "name": "@landrush/runtime",
  "version": "0.1.0",
  "description": "Pascal-independent Landrush game runtime",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./landrush-island-palm-construction-visibility": {
      "types": "./src/landrush-island-palm-construction-visibility.ts",
      "default": "./src/landrush-island-palm-construction-visibility.ts"
    },
    "./zombie-game-client": {
      "types": "./src/zombie-game-client.ts",
      "default": "./src/zombie-game-client.ts"
    },
    "./landrush-island-ambient-navigation": {
      "types": "./src/landrush-island-ambient-navigation.ts",
      "default": "./src/landrush-island-ambient-navigation.ts"
    },
    "./landrush-island-ambient-npc-motion": {
      "types": "./src/landrush-island-ambient-npc-motion.ts",
      "default": "./src/landrush-island-ambient-npc-motion.ts"
    },
    "./navigation-geometry": {
      "types": "./src/navigation-geometry.ts",
      "default": "./src/navigation-geometry.ts"
    },
    "./semantic-item-collision": {
      "types": "./src/semantic-item-collision.ts",
      "default": "./src/semantic-item-collision.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test src"
  },
  "peerDependencies": {
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "react": "^18 || ^19",
    "three": "^0.185"
  },
  "dependencies": {
    "@landrush/protocol": "*",
    "three-mesh-bvh": "~0.9.8"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.19.12",
    "@types/react": "^19.2.2",
    "@types/three": "^0.184.1",
    "react": "^19.2.4",
    "three": "^0.185.0",
    "typescript": "7.0.2"
  },
  "private": true
}
